# EmPay HRMS Backend Environment Variables

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/empay_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── Payroll Defaults ─────────────────────────────────────────────────────────
# PF deduction percentage (12%)
PF_PERCENTAGE=0.12
# Professional tax fixed monthly amount (INR)
PROFESSIONAL_TAX=200
# Default total working days in a month
TOTAL_WORKING_DAYS=26
